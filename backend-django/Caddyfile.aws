# Point this DNS hostname at the instance's associated Elastic IP. Caddy manages
# the public domain certificate and HTTP-to-HTTPS redirect automatically.
{$MOTION_AI_API_HOST} {
    encode zstd gzip
    reverse_proxy api:8000
}

# Temporary public website destination, including /terms and /privacy.
# API, sign-in, owner and Play callback requests use api.motionmagicai.in.
motionmagicai.in, www.motionmagicai.in {
    redir https://gamixtv.in{uri} 302
}
