# Point this DNS hostname at the instance's associated Elastic IP. Caddy manages
# the public domain certificate and HTTP-to-HTTPS redirect automatically.
{$MOTION_AI_API_HOST} {
    encode zstd gzip
    reverse_proxy api:8000
}

# Browser studio. Android and Play callbacks keep the API hostname above.
motionmagicai.in {
    encode zstd gzip
    @legal path /terms /terms/* /privacy /privacy/* /privacy-policy /privacy-policy/*
    redir @legal https://gamixtv.in{uri} 302
    reverse_proxy api:8000
}

www.motionmagicai.in {
    redir https://motionmagicai.in{uri} 308
}
