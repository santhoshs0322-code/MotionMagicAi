# All app settings use MOTION_AI_. No secrets belong in Android.
MOTION_AI_DEBUG=false
MOTION_AI_TESTING=false
MOTION_AI_DJANGO_SECRET=
MOTION_AI_JWT_SECRET=
MOTION_AI_ALLOWED_HOSTS=api.your-domain.example
MOTION_AI_DATABASE_URL=postgresql://motion_ai:CHANGE_ME@postgres:5432/motion_ai
MOTION_AI_REDIS_URL=redis://redis:6379/0
MOTION_AI_BEHIND_ALB=true
# Render Blueprint sets this to render; AWS uses alb; direct local serving uses none.
MOTION_AI_PROXY_MODE=alb
MOTION_AI_SSL_REDIRECT=true
MOTION_AI_CSRF_TRUSTED_ORIGINS=https://api.your-domain.example
MOTION_AI_AUTH_ENABLED=false
MOTION_AI_GOOGLE_CLIENT_ID=
MOTION_AI_SESSION_SECONDS=86400
MOTION_AI_WEB_WORKERS=2
MOTION_AI_WEB_THREADS=4
MOTION_AI_AWS_REGION=ap-south-1
MOTION_AI_S3_BUCKET=
# Render only. Leave these blank on AWS ECS and use an IAM task role.
MOTION_AI_AWS_ACCESS_KEY_ID=
MOTION_AI_AWS_SECRET_ACCESS_KEY=
MOTION_AI_AWS_SESSION_TOKEN=
MOTION_AI_MAX_UPLOAD_BYTES=2147483648
# Server-only Google Gemini image generation. Never ship this key in Android.
MOTION_AI_GEMINI_API_KEY=
MOTION_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
MOTION_AI_GEMINI_INTERACTIONS_URL=https://generativelanguage.googleapis.com/v1beta
MOTION_AI_GEMINI_MAX_INPUT_BYTES=10485760
MOTION_AI_GEMINI_MAX_OUTPUT_BYTES=33554432
MOTION_AI_GEMINI_MAX_VIDEO_BYTES=536870912
# Set current complete variable provider cost in paise. Zero keeps that rate hidden.
MOTION_AI_GEMINI_OVERHEAD_PAISE=0
MOTION_AI_GEMINI_NANO_21_1K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_21_2K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_21_4K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_2_1K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_2_2K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_2_4K_COST_PAISE=0
MOTION_AI_GEMINI_LITE_1K_COST_PAISE=0
MOTION_AI_GEMINI_PRO_1K_COST_PAISE=0
MOTION_AI_GEMINI_PRO_2K_COST_PAISE=0
MOTION_AI_GEMINI_PRO_4K_COST_PAISE=0
MOTION_AI_GEMINI_OMNI_720P_COST_PAISE_PER_SECOND=0
MOTION_AI_GEMINI_OMNI_1080P_COST_PAISE_PER_SECOND=0
MOTION_AI_GEMINI_OMNI_4K_COST_PAISE_PER_SECOND=0
# Empty gateway means cloud generation is hidden, never simulated or billed.
MOTION_AI_GATEWAY_URL=
MOTION_AI_GATEWAY_TOKEN=
MOTION_AI_DAILY_PROVIDER_BUDGET_PAISE=0
MOTION_AI_MAX_ACTIVE_JOBS=2
MOTION_AI_GENERATION_LEASE_SECONDS=1200
# 150% markup = cost x 2.5 = 60% gross margin before additional expenses.
MOTION_AI_MARKUP_BPS=15000
# Configure actual store fee; not a universal Play rate. 1500 would mean 15%.
MOTION_AI_STORE_FEE_BPS=0
MOTION_AI_PLAY_ENABLED=false
MOTION_AI_PLAY_PACKAGE=com.motionmagic.ai
MOTION_AI_PLAY_CREDENTIALS_FILE=/run/secrets/google-play.json
MOTION_AI_BILLING_ENCRYPTION_KEY=
