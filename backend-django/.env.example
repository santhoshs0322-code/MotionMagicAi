# All app settings use MOTION_AI_. No secrets belong in Android.
MOTION_AI_DEBUG=false
MOTION_AI_TESTING=false
MOTION_AI_DJANGO_SECRET=
MOTION_AI_JWT_SECRET=
MOTION_AI_ALLOWED_HOSTS=api.your-domain.example
MOTION_AI_DATABASE_URL=postgresql://motion_ai:CHANGE_ME@postgres:5432/motion_ai
MOTION_AI_REDIS_URL=redis://redis:6379/0
MOTION_AI_BEHIND_ALB=true
# Render Blueprint sets this to render; AWS uses alb; direct local serving uses none.
MOTION_AI_PROXY_MODE=alb
MOTION_AI_SSL_REDIRECT=true
MOTION_AI_CSRF_TRUSTED_ORIGINS=https://api.your-domain.example
MOTION_AI_AUTH_ENABLED=false
MOTION_AI_GOOGLE_CLIENT_ID=
MOTION_AI_SESSION_SECONDS=86400
MOTION_AI_REFRESH_DAYS=90
MOTION_AI_WEB_WORKERS=2
MOTION_AI_WEB_THREADS=4
MOTION_AI_AWS_REGION=ap-south-1
MOTION_AI_S3_BUCKET=
# Render only. Leave these blank on AWS ECS and use an IAM task role.
MOTION_AI_AWS_ACCESS_KEY_ID=
MOTION_AI_AWS_SECRET_ACCESS_KEY=
MOTION_AI_AWS_SESSION_TOKEN=
MOTION_AI_MAX_UPLOAD_BYTES=2147483648
# Historical Google adapter only; disabled for new work while FAL_ONLY=true.
MOTION_AI_GEMINI_API_KEY=
MOTION_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
MOTION_AI_GEMINI_INTERACTIONS_URL=https://generativelanguage.googleapis.com/v1beta
MOTION_AI_GEMINI_MAX_INPUT_BYTES=10485760
MOTION_AI_GEMINI_MAX_OUTPUT_BYTES=33554432
MOTION_AI_GEMINI_MAX_VIDEO_BYTES=536870912
# Set current complete variable provider cost in paise. Zero keeps that rate hidden.
MOTION_AI_GEMINI_OVERHEAD_PAISE=0
MOTION_AI_GEMINI_NANO_21_1K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_21_2K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_21_4K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_2_1K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_2_2K_COST_PAISE=0
MOTION_AI_GEMINI_NANO_2_4K_COST_PAISE=0
MOTION_AI_GEMINI_LITE_1K_COST_PAISE=0
MOTION_AI_GEMINI_PRO_1K_COST_PAISE=0
MOTION_AI_GEMINI_PRO_2K_COST_PAISE=0
MOTION_AI_GEMINI_PRO_4K_COST_PAISE=0
MOTION_AI_GEMINI_OMNI_720P_COST_PAISE_PER_SECOND=0
MOTION_AI_GEMINI_OMNI_1080P_COST_PAISE_PER_SECOND=0
MOTION_AI_GEMINI_OMNI_4K_COST_PAISE_PER_SECOND=0
# Launch uses fal.ai alone; Nano Banana is excluded. See OWNER_SETUP.md.
MOTION_AI_FAL_ONLY=true
# Empty owner username disables the private console. Create its superuser separately.
MOTION_AI_OWNER_USERNAME=
# Temporary: creates the owner once during deployment; remove after successful login.
MOTION_AI_OWNER_BOOTSTRAP_PASSWORD=
# Optional billed-cost reconciliation: BILLING permission and verified INR/USD required.
MOTION_AI_FAL_BILLING_KEY=
MOTION_AI_USD_INR_RATE=0
# Same generation key on API and worker.
MOTION_AI_FAL_KEY=
MOTION_AI_FAL_OVERHEAD_PAISE=0
# Values below are raw provider USD-cent allowances, not INR paise. Customer
# charge = allowance x 5 with MARKUP_BPS=40000 (80% provider-cost margin).
MOTION_AI_FAL_QWEN_IMAGE_720P_COST_PAISE=2
MOTION_AI_FAL_QWEN_IMAGE_1080P_COST_PAISE=4
MOTION_AI_FAL_GPT_IMAGE_2_5_S_1K_COST_PAISE=7
MOTION_AI_FAL_GPT_IMAGE_2_5_S_2K_COST_PAISE=25
MOTION_AI_FAL_GPT_IMAGE_2_5_F_1K_COST_PAISE=7
MOTION_AI_FAL_GPT_IMAGE_2_5_F_2K_COST_PAISE=25
MOTION_AI_FAL_GPT_IMAGE_2_1K_COST_PAISE=22
MOTION_AI_FAL_GPT_IMAGE_2_2K_COST_PAISE=42
MOTION_AI_FAL_NANO_BANANA_1K_COST_PAISE=0
MOTION_AI_FAL_SEEDREAM_5_PRO_1K_COST_PAISE=7
MOTION_AI_FAL_SEEDREAM_5_PRO_2K_COST_PAISE=14
# Keep these zero until verified in your fal dashboard: fal does not publish a
# stable complete cost for the selected endpoint in its public model page.
MOTION_AI_FAL_SEEDREAM_5_LITE_2K_COST_PAISE=0
MOTION_AI_FAL_SEEDREAM_4_5_2K_COST_PAISE=0
# Per video second. Sound ON and OFF are separately priced services.
MOTION_AI_FAL_KLING_3_OMNI_720P_SILENT_COST_PAISE_PER_SECOND=9
MOTION_AI_FAL_KLING_3_OMNI_720P_AUDIO_COST_PAISE_PER_SECOND=12
MOTION_AI_FAL_KLING_3_OMNI_1080P_SILENT_COST_PAISE_PER_SECOND=0
MOTION_AI_FAL_KLING_3_OMNI_1080P_AUDIO_COST_PAISE_PER_SECOND=0
MOTION_AI_FAL_PIXVERSE_V6_720P_SILENT_COST_PAISE_PER_SECOND=5
MOTION_AI_FAL_PIXVERSE_V6_720P_AUDIO_COST_PAISE_PER_SECOND=6
MOTION_AI_FAL_PIXVERSE_V6_1080P_SILENT_COST_PAISE_PER_SECOND=9
MOTION_AI_FAL_PIXVERSE_V6_1080P_AUDIO_COST_PAISE_PER_SECOND=12
# Optional private gateway for other services; fal/Google do not require it.
MOTION_AI_GATEWAY_URL=
MOTION_AI_GATEWAY_TOKEN=
MOTION_AI_DAILY_PROVIDER_BUDGET_PAISE=1000
# One shard makes the $10 launch cap usable for video. Raise both the daily cap
# and shards together when you move to AWS scale (maximum 64 shards).
MOTION_AI_BUDGET_SHARDS=1
MOTION_AI_WELCOME_CREDITS=200
MOTION_AI_MAX_ACTIVE_JOBS=2
MOTION_AI_GENERATION_LEASE_SECONDS=1200
# 900% markup = cost x 10. With 200 credits = US$1 customer value, this
# preserves the requested 80% provider-cost gross margin before store fees.
MOTION_AI_MARKUP_BPS=90000
# Configure actual store fee; not a universal Play rate. 1500 would mean 15%.
MOTION_AI_STORE_FEE_BPS=0
MOTION_AI_PLAY_ENABLED=false
# Legacy switch. New deployments should use ENABLE_TOPUPS instead.
MOTION_AI_ENABLE_CREDIT_PACKS=false
MOTION_AI_ENABLE_TOPUPS=false
MOTION_AI_SUBSCRIPTIONS_ENABLED=false
# Set this once. The Pub/Sub audience/callback is derived automatically as
# CURRENT_SITE_URL + /api/v1/billing/play-notifications.
MOTION_AI_CURRENT_SITE_URL=https://motionmagicai.onrender.com
# Optional override for an advanced proxy configuration.
MOTION_AI_PLAY_PUBSUB_AUDIENCE=
MOTION_AI_PLAY_PUBSUB_SERVICE_ACCOUNT=
MOTION_AI_PLAY_PACKAGE=com.gamixtv.MotionMagicAI
MOTION_AI_PLAY_CREDENTIALS_FILE=/run/secrets/google-play.json
MOTION_AI_BILLING_ENCRYPTION_KEY=
