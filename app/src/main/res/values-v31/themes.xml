<resources>
    <style name="Theme.MotionMagic" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="android:colorAccent">@color/brand_purple</item>
    </style>
    <style name="Theme.MotionMagic.Light" parent="Theme.MotionMagic.Light.Base">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F2F3FA</item>
        <item name="android:navigationBarColor">#F2F3FA</item>
        <item name="android:windowBackground">#F2F3FA</item>
        <item name="android:windowSplashScreenBackground">#F2F3FA</item>
    </style>
</resources>

